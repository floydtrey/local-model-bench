# V2 benchmark packs and fixtures are content-addressed evidence.
# Force LF checkout on every platform so declared SHA-256 values identify the
# same exact bytes on Windows and POSIX hosts.
benchmark-packs/v2/*.json text eol=lf
benchmark-packs/v2/fixtures/** text eol=lf
benchmark-packs/v2/workspaces/** text eol=lf

# Flash-Next source snapshots and campaign evidence identities are byte-addressed.
# Preserve original source blobs (including any original CRLF) without conversion.
campaigns/flashnext-all-roles-v1/sources/** -text
campaigns/flashnext-all-roles-v1/*.json text eol=lf
src/localbench/v2/*.py text eol=lf
schemas/v2/*.json text eol=lf
project-benchmarks/*/qualification-v2/planner-input-v1/** text eol=lf
project-benchmarks/*/qualification-v2/PLANNER_PACKET.json text eol=lf
docs/qualification-v2/planner-calibration/** text eol=lf
docs/qualification-v2/governor-v1/** text eol=lf
docs/qualification-v2/governor-calibration/** text eol=lf
src/localbench/qualification_v2/*.py text eol=lf
tools/campaigns/*.ps1 text eol=lf
