{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-model-bench.invalid/schemas/v2/effective-config-spec.schema.json",
  "title": "Benchmark Lab V2 canonical runtime configuration request",
  "type": "object",
  "required": ["schema_version", "comparison_mode", "generation", "execution", "tool_surface"],
  "properties": {
    "schema_version": {"const": "benchmark-lab-runtime-config:v3"},
    "comparison_mode": {"enum": ["strict", "exploratory"]},
    "generation": {
      "type": "object",
      "required": ["context_tokens", "max_output_tokens", "response_format", "reasoning"],
      "properties": {
        "context_tokens": {"type": "integer", "minimum": 1},
        "max_output_tokens": {"type": "integer", "minimum": 1},
        "temperature": {"type": "number", "minimum": 0},
        "seed": {"type": "integer", "minimum": 0},
        "top_p": {"type": "number", "minimum": 0, "maximum": 1},
        "top_k": {"type": ["integer", "null"], "minimum": 1},
        "repeat_penalty": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "stop": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "response_format": {
          "type": "object",
          "required": ["mode", "schema"],
          "properties": {
            "mode": {"enum": ["text", "json_object", "json_schema"]},
            "schema": {"type": ["object", "null"]}
          },
          "additionalProperties": false
        },
        "reasoning": {
          "type": "object",
          "required": ["mode", "effort"],
          "properties": {
            "mode": {"enum": ["enabled", "disabled", "unsupported"]},
            "effort": {"enum": ["low", "medium", "high", "max", null]}
          },
          "allOf": [
            {
              "if": {"properties": {"mode": {"enum": ["disabled", "unsupported"]}}},
              "then": {"properties": {"effort": {"type": "null"}}}
            }
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["timeout_seconds", "model_residency", "network_policy"],
      "properties": {
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "retries": {"type": "integer", "minimum": 0},
        "retry_delay_seconds": {"type": "number", "minimum": 0},
        "concurrency": {"type": "integer", "minimum": 1},
        "model_residency": {
          "type": "object",
          "required": ["mode", "keep_alive_seconds"],
          "properties": {
            "mode": {"enum": ["unload_after_model", "keep_loaded"]},
            "keep_alive_seconds": {"type": ["number", "null"], "minimum": 0}
          },
          "additionalProperties": false
        },
        "network_policy": {"enum": ["provider_only", "disabled", "task_allowed"]}
      },
      "additionalProperties": false
    },
    "tool_surface": {
      "type": "object",
      "required": ["id", "tools", "max_tool_calls", "schema_sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "tools": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "max_tool_calls": {"type": "integer", "minimum": 0},
        "schema_sha256": {
          "oneOf": [
            {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            {"type": "null"}
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
