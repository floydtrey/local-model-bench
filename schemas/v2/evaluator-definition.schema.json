{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-model-bench.invalid/schemas/v2/evaluator-definition.schema.json",
  "title": "Benchmark Lab V2 Evaluator Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluator_id",
    "contract_version",
    "implementation_sha256",
    "input_contract",
    "result_contract",
    "consumed_evidence",
    "requires_human_review",
    "scoring_mode"
  ],
  "properties": {
    "schema_version": {"const": "benchmark-lab-evaluator:v2"},
    "evaluator_id": {"$ref": "#/$defs/safeId"},
    "contract_version": {"$ref": "#/$defs/safeId"},
    "implementation_sha256": {"$ref": "#/$defs/sha256"},
    "input_contract": {"type": "string", "minLength": 1},
    "result_contract": {"type": "string", "minLength": 1},
    "consumed_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidenceConsumption"}
    },
    "requires_human_review": {"type": "boolean"},
    "scoring_mode": {"enum": ["weighted", "unscored"]}
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "recordType": {
      "enum": [
        "host_profile",
        "runtime_profile",
        "model_identity",
        "effective_runtime_config",
        "benchmark_input",
        "evaluator_identity",
        "trial_identity",
        "run_manifest",
        "case_result",
        "evaluation_result"
      ]
    },
    "evidenceConsumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "required", "multiple"],
      "properties": {
        "record_type": {"$ref": "#/$defs/recordType"},
        "required": {"type": "boolean"},
        "multiple": {"type": "boolean"}
      }
    }
  }
}
