{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-model-bench.invalid/schemas/v2/containment-execution.schema.json",
  "title": "Benchmark Lab BL-7 containment execution payload",
  "type": "object",
  "required": [
    "execution_version", "policy", "policy_sha256", "backend", "command_id",
    "command_sha256", "cwd_role", "attempt", "status", "stop_reason",
    "exit_code", "started_unix_seconds", "finished_unix_seconds",
    "duration_seconds", "cleanup_performed", "stdout", "stderr"
  ],
  "properties": {
    "execution_version": {"const": "benchmark-lab-containment-execution:v1"},
    "policy": {
      "type": "object",
      "required": [
        "schema_version", "wall_seconds", "max_attempts", "network_policy",
        "process_custody", "require_workspace_isolation",
        "require_assessor_isolation", "writable_paths", "max_output_bytes",
        "max_memory_bytes"
      ],
      "properties": {
        "schema_version": {"const": "benchmark-lab-containment-policy:v1"},
        "wall_seconds": {"type": "number", "exclusiveMinimum": 0},
        "max_attempts": {"type": "integer", "minimum": 1},
        "network_policy": {"enum": ["disabled", "provider_only", "task_allowed"]},
        "process_custody": {"enum": ["best_effort", "strict"]},
        "require_workspace_isolation": {"type": "boolean"},
        "require_assessor_isolation": {"type": "boolean"},
        "writable_paths": {
          "oneOf": [
            {"type": "null"},
            {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          ]
        },
        "max_output_bytes": {"type": ["integer", "null"], "minimum": 1},
        "max_memory_bytes": {"type": ["integer", "null"], "minimum": 1}
      },
      "additionalProperties": false
    },
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "backend": {
      "type": "object",
      "required": [
        "backend_id", "backend_version", "wall_clock_timeout", "process_custody",
        "network_policies", "workspace_isolation", "workspace_write_scope",
        "assessor_isolation", "output_limit", "memory_limit"
      ],
      "properties": {
        "backend_id": {"type": "string", "minLength": 1},
        "backend_version": {"type": "string", "minLength": 1},
        "wall_clock_timeout": {"type": "boolean"},
        "process_custody": {"enum": ["none", "best_effort", "strict"]},
        "network_policies": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["disabled", "provider_only", "task_allowed"]}
        },
        "workspace_isolation": {"type": "boolean"},
        "workspace_write_scope": {"type": "boolean"},
        "assessor_isolation": {"type": "boolean"},
        "output_limit": {"type": "boolean"},
        "memory_limit": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "command_id": {"type": "string", "minLength": 1},
    "command_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cwd_role": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "status": {"enum": ["completed", "timeout", "error", "resource_limit"]},
    "stop_reason": {"type": "string", "minLength": 1},
    "exit_code": {"type": ["integer", "null"]},
    "started_unix_seconds": {"type": "number"},
    "finished_unix_seconds": {"type": "number"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "cleanup_performed": {"type": "boolean"},
    "stdout": {"$ref": "#/$defs/stream"},
    "stderr": {"$ref": "#/$defs/stream"}
  },
  "$defs": {
    "stream": {
      "type": "object",
      "required": ["sha256", "size_bytes", "utf8"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "utf8": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
