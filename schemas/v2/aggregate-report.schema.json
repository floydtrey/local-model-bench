{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-model-bench.invalid/schemas/v2/aggregate-report.schema.json",
  "title": "Benchmark Lab BL-8B derived aggregate report payload",
  "type": "object",
  "required": [
    "report_version", "manifest", "benchmark", "repetition_phase",
    "planned_trials", "observed_trials", "overall", "cases", "evidence"
  ],
  "properties": {
    "report_version": {"const": "benchmark-lab-aggregate-report:v1"},
    "manifest": {"$ref": "#/$defs/evidenceRef"},
    "benchmark": {"$ref": "#/$defs/evidenceRef"},
    "repetition_phase": {"enum": ["screen", "qualification"]},
    "planned_trials": {"type": "integer", "minimum": 1},
    "observed_trials": {"type": "integer", "minimum": 0},
    "overall": {"$ref": "#/$defs/summary"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/caseAggregate"}
    },
    "evidence": {"$ref": "#/$defs/evidenceSets"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidenceRef": {
      "type": "object",
      "required": ["record_type", "logical_id", "sha256"],
      "properties": {
        "record_type": {"type": "string", "minLength": 1},
        "logical_id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "nullableNumber": {"type": ["number", "null"]},
    "numericStats": {
      "type": "object",
      "required": [
        "measured", "expected", "minimum", "maximum", "mean", "median",
        "population_variance"
      ],
      "properties": {
        "measured": {"type": "integer", "minimum": 0},
        "expected": {"type": "integer", "minimum": 0},
        "minimum": {"$ref": "#/$defs/nullableNumber"},
        "maximum": {"$ref": "#/$defs/nullableNumber"},
        "mean": {"$ref": "#/$defs/nullableNumber"},
        "median": {"$ref": "#/$defs/nullableNumber"},
        "population_variance": {"$ref": "#/$defs/nullableNumber"}
      },
      "additionalProperties": false
    },
    "hardFailures": {
      "type": "object",
      "required": ["total", "evaluations_affected", "by_rule"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "evaluations_affected": {"type": "integer", "minimum": 0},
        "by_rule": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 1}
        }
      },
      "additionalProperties": false
    },
    "evaluationSummary": {
      "type": "object",
      "required": [
        "evaluation_count", "verdict_counts", "pass_rate",
        "verdict_consistency_rate", "raw_score", "normalized_score",
        "hard_failures"
      ],
      "properties": {
        "evaluation_count": {"type": "integer", "minimum": 0},
        "verdict_counts": {
          "type": "object",
          "required": ["fail", "not_scored", "pass", "review"],
          "properties": {
            "fail": {"type": "integer", "minimum": 0},
            "not_scored": {"type": "integer", "minimum": 0},
            "pass": {"type": "integer", "minimum": 0},
            "review": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "pass_rate": {"$ref": "#/$defs/nullableNumber"},
        "verdict_consistency_rate": {"$ref": "#/$defs/nullableNumber"},
        "raw_score": {"$ref": "#/$defs/numericStats"},
        "normalized_score": {"$ref": "#/$defs/numericStats"},
        "hard_failures": {"$ref": "#/$defs/hardFailures"}
      },
      "additionalProperties": false
    },
    "executionSummary": {
      "type": "object",
      "required": [
        "case_result_count", "status_counts", "status_consistency_rate",
        "duration_seconds", "attempts", "retries", "model_turns", "tool_calls",
        "authorized_tool_calls", "denied_tool_calls", "successful_tool_calls",
        "failed_tool_calls", "telemetry"
      ],
      "properties": {
        "case_result_count": {"type": "integer", "minimum": 0},
        "status_counts": {"type": "object"},
        "status_consistency_rate": {"$ref": "#/$defs/nullableNumber"},
        "duration_seconds": {"$ref": "#/$defs/numericStats"},
        "attempts": {"$ref": "#/$defs/numericStats"},
        "retries": {"$ref": "#/$defs/numericStats"},
        "model_turns": {"$ref": "#/$defs/numericStats"},
        "tool_calls": {"$ref": "#/$defs/numericStats"},
        "authorized_tool_calls": {"$ref": "#/$defs/numericStats"},
        "denied_tool_calls": {"$ref": "#/$defs/numericStats"},
        "successful_tool_calls": {"$ref": "#/$defs/numericStats"},
        "failed_tool_calls": {"$ref": "#/$defs/numericStats"},
        "telemetry": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/numericStats"}
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["execution", "evaluation"],
      "properties": {
        "execution": {"$ref": "#/$defs/executionSummary"},
        "evaluation": {"$ref": "#/$defs/evaluationSummary"}
      },
      "additionalProperties": false
    },
    "refArray": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidenceRef"}
    },
    "evidenceSets": {
      "type": "object",
      "required": ["trials", "execution_evidence", "case_results", "evaluation_results"],
      "properties": {
        "trials": {"$ref": "#/$defs/refArray"},
        "execution_evidence": {"$ref": "#/$defs/refArray"},
        "case_results": {"$ref": "#/$defs/refArray"},
        "evaluation_results": {"$ref": "#/$defs/refArray"}
      },
      "additionalProperties": false
    },
    "caseEvidence": {
      "type": "object",
      "required": ["trials", "case_results", "evaluation_results"],
      "properties": {
        "trials": {"$ref": "#/$defs/refArray"},
        "case_results": {"$ref": "#/$defs/refArray"},
        "evaluation_results": {"$ref": "#/$defs/refArray"}
      },
      "additionalProperties": false
    },
    "evaluatorAggregate": {
      "type": "object",
      "required": [
        "evaluator", "evaluation_count", "verdict_counts", "pass_rate",
        "verdict_consistency_rate", "raw_score", "normalized_score",
        "hard_failures", "evidence"
      ],
      "properties": {
        "evaluator": {"$ref": "#/$defs/evidenceRef"},
        "evaluation_count": {"type": "integer", "minimum": 0},
        "verdict_counts": {"type": "object"},
        "pass_rate": {"$ref": "#/$defs/nullableNumber"},
        "verdict_consistency_rate": {"$ref": "#/$defs/nullableNumber"},
        "raw_score": {"$ref": "#/$defs/numericStats"},
        "normalized_score": {"$ref": "#/$defs/numericStats"},
        "hard_failures": {"$ref": "#/$defs/hardFailures"},
        "evidence": {"$ref": "#/$defs/refArray"}
      },
      "additionalProperties": false
    },
    "caseAggregate": {
      "type": "object",
      "required": [
        "case_id", "repeat_group", "planned_trials", "observed_trials",
        "execution", "evaluation", "evaluators", "evidence"
      ],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "repeat_group": {"type": "string", "minLength": 1},
        "planned_trials": {"type": "integer", "minimum": 1},
        "observed_trials": {"type": "integer", "minimum": 0},
        "execution": {"$ref": "#/$defs/executionSummary"},
        "evaluation": {"$ref": "#/$defs/evaluationSummary"},
        "evaluators": {
          "type": "array",
          "items": {"$ref": "#/$defs/evaluatorAggregate"}
        },
        "evidence": {"$ref": "#/$defs/caseEvidence"}
      },
      "additionalProperties": false
    }
  }
}
