{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-model-bench.invalid/schemas/v2/containment-policy.schema.json",
  "title": "Benchmark Lab V2 containment policy",
  "type": "object",
  "required": [
    "schema_version",
    "wall_seconds",
    "max_attempts",
    "network_policy",
    "process_custody",
    "require_workspace_isolation",
    "require_assessor_isolation",
    "writable_paths",
    "max_output_bytes",
    "max_memory_bytes"
  ],
  "properties": {
    "schema_version": {"const": "benchmark-lab-containment-policy:v1"},
    "wall_seconds": {"type": "number", "exclusiveMinimum": 0},
    "max_attempts": {"type": "integer", "minimum": 1},
    "network_policy": {"enum": ["disabled", "provider_only", "task_allowed"]},
    "process_custody": {"enum": ["best_effort", "strict"]},
    "require_workspace_isolation": {"type": "boolean"},
    "require_assessor_isolation": {"type": "boolean"},
    "writable_paths": {
      "oneOf": [
        {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        {"type": "null"}
      ]
    },
    "max_output_bytes": {
      "oneOf": [
        {"type": "integer", "minimum": 1},
        {"type": "null"}
      ]
    },
    "max_memory_bytes": {
      "oneOf": [
        {"type": "integer", "minimum": 1},
        {"type": "null"}
      ]
    }
  },
  "additionalProperties": false
}
