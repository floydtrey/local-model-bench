{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-model-bench.invalid/schemas/v2/execution-binding.schema.json",
  "title": "Benchmark Lab BL-8A pre-run execution binding payload",
  "type": "object",
  "required": [
    "trial", "execution_mode", "driver", "workspace_scope",
    "context_assets", "containment"
  ],
  "properties": {
    "trial": {
      "type": "object",
      "required": ["record_type", "logical_id", "sha256"],
      "properties": {
        "record_type": {"const": "trial_identity"},
        "logical_id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "execution_mode": {"enum": ["intrinsic", "lab_tool"]},
    "driver": {
      "type": "object",
      "required": ["driver_id", "implementation_sha256", "execution_kind"],
      "properties": {
        "driver_id": {"type": "string", "minLength": 1},
        "implementation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "execution_kind": {"enum": ["in_process", "subprocess"]},
        "tool_surface_binding": {
          "type": "object",
          "required": [
            "required_capability", "required_tools", "concrete_surface",
            "concrete_schema_sha256"
          ],
          "properties": {
            "required_capability": {"const": "bounded-files-v1"},
            "required_tools": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            },
            "concrete_surface": {"const": "lab-bounded-files:v1"},
            "concrete_schema_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "workspace_scope": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["readable_paths", "writable_paths"],
          "properties": {
            "readable_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "writable_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          },
          "additionalProperties": false
        }
      ]
    },
    "context_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "sha256", "media_type", "delivery", "delivery_target"],
        "properties": {
          "asset_id": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "media_type": {"type": "string", "minLength": 1},
          "delivery": {"enum": ["inline_context", "readonly_reference"]},
          "delivery_target": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "containment": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["policy_sha256", "backend"],
          "properties": {
            "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "backend": {"type": "object"}
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
