{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-model-bench.invalid/schemas/v2/benchmark-pack.schema.json",
  "title": "Benchmark Lab V2 Benchmark Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "pack_version",
    "name",
    "description",
    "level",
    "cases"
  ],
  "properties": {
    "schema_version": {"const": "benchmark-lab-pack:v2"},
    "pack_id": {"$ref": "#/$defs/safeId"},
    "pack_version": {"$ref": "#/$defs/safeId"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": ["string", "null"], "minLength": 1},
    "level": {"enum": ["L0", "L1", "L2", "L3", "L4"]},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"level": {"const": "L0"}}, "required": ["level"]},
      "then": {
        "properties": {
          "cases": {
            "items": {
              "allOf": [
                {
                  "properties": {
                    "input": {
                      "properties": {
                        "context_assets": {"maxItems": 0}
                      }
                    }
                  }
                },
                {"$ref": "#/$defs/noToolsCase"}
              ]
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"level": {"const": "L1"}}, "required": ["level"]},
      "then": {
        "properties": {
          "cases": {
            "items": {"$ref": "#/$defs/noToolsCase"}
          }
        }
      }
    }
  ],
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": {"enum": ["system", "user", "assistant"]},
        "content": {"type": "string"}
      }
    },
    "contextAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "sha256", "media_type", "delivery", "source_locator"],
      "properties": {
        "asset_id": {"$ref": "#/$defs/safeId"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "media_type": {"type": "string", "minLength": 1},
        "delivery": {"enum": ["inline_context", "readonly_reference"]},
        "source_locator": {"type": "string", "minLength": 1}
      }
    },
    "responseContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "schema"],
      "properties": {
        "mode": {"enum": ["text", "json_object", "json_schema"]},
        "schema": {"type": ["object", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "json_schema"}}, "required": ["mode"]},
          "then": {"properties": {"schema": {"type": "object"}}},
          "else": {"properties": {"schema": {"type": "null"}}}
        }
      ]
    },
    "toolSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "required_tools"],
      "properties": {
        "id": {"$ref": "#/$defs/safeId"},
        "required_tools": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/safeId"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"id": {"const": "none"}}, "required": ["id"]},
          "then": {"properties": {"required_tools": {"maxItems": 0}}},
          "else": {"properties": {"required_tools": {"minItems": 1}}}
        }
      ]
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuration_profile",
        "response_contract",
        "tool_surface",
        "minimum_context_tokens"
      ],
      "properties": {
        "configuration_profile": {"$ref": "#/$defs/safeId"},
        "response_contract": {"$ref": "#/$defs/responseContract"},
        "tool_surface": {"$ref": "#/$defs/toolSurface"},
        "minimum_context_tokens": {
          "anyOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ]
        }
      }
    },
    "evaluatorRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluator_id", "contract_version"],
      "properties": {
        "evaluator_id": {"$ref": "#/$defs/safeId"},
        "contract_version": {"$ref": "#/$defs/safeId"}
      }
    },
    "hardFailureRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluator_id", "rule_id"],
      "properties": {
        "evaluator_id": {"$ref": "#/$defs/safeId"},
        "rule_id": {"$ref": "#/$defs/safeId"}
      }
    },
    "repetitions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screen_trials", "qualification_trials"],
      "properties": {
        "screen_trials": {"type": "integer", "minimum": 1},
        "qualification_trials": {"type": "integer", "minimum": 1}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "objective",
        "input",
        "requirements",
        "evaluators",
        "hard_failure_rules",
        "repetitions",
        "tags"
      ],
      "properties": {
        "case_id": {"$ref": "#/$defs/safeId"},
        "objective": {"type": "string", "minLength": 1},
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["messages", "context_assets"],
          "properties": {
            "messages": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/message"}
            },
            "context_assets": {
              "type": "array",
              "items": {"$ref": "#/$defs/contextAsset"}
            }
          }
        },
        "requirements": {"$ref": "#/$defs/requirements"},
        "evaluators": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evaluatorRef"}
        },
        "hard_failure_rules": {
          "type": "array",
          "items": {"$ref": "#/$defs/hardFailureRule"}
        },
        "repetitions": {"$ref": "#/$defs/repetitions"},
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/safeId"}
        }
      }
    },
    "noToolsCase": {
      "type": "object",
      "properties": {
        "requirements": {
          "properties": {
            "tool_surface": {
              "properties": {
                "id": {"const": "none"},
                "required_tools": {"maxItems": 0}
              }
            }
          }
        }
      }
    }
  }
}
