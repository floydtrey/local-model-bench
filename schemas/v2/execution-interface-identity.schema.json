{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benchmark-lab-execution-interface-identity:v1",
  "title": "Benchmark Lab V2 Execution Interface Identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "logical_id", "sha256", "payload"],
  "properties": {
    "schema_version": {"const": "benchmark-lab-evidence:v2"},
    "record_type": {"const": "execution_interface_identity"},
    "logical_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interface_version",
        "runtime",
        "model",
        "backend_kind",
        "adapter_id",
        "tool_transport_mode",
        "parser_mode",
        "parser_id",
        "raw_interaction_contract",
        "normalized_tool_call_contract",
        "capabilities",
        "malformed_call_policy",
        "backend_tool_execution"
      ],
      "properties": {
        "interface_version": {"const": "benchmark-lab-execution-interface:v1"},
        "runtime": {"$ref": "#/$defs/runtimeRef"},
        "model": {"$ref": "#/$defs/modelRef"},
        "backend_kind": {"type": "string", "minLength": 1},
        "adapter_id": {"type": "string", "minLength": 1},
        "tool_transport_mode": {
          "enum": [
            "native_structured",
            "model_aware_structured",
            "prompt_parsed",
            "unavailable"
          ]
        },
        "parser_mode": {
          "enum": ["provider_native", "model_aware", "prompt_based", "none"]
        },
        "parser_id": {
          "anyOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "raw_interaction_contract": {"type": "string", "minLength": 1},
        "normalized_tool_call_contract": {
          "const": "benchmark-lab-normalized-tool-call:v1"
        },
        "capabilities": {"type": "object"},
        "malformed_call_policy": {"const": "fail_closed"},
        "backend_tool_execution": {"const": "forbidden"}
      },
      "allOf": [
        {
          "if": {"properties": {"parser_mode": {"const": "none"}}},
          "then": {
            "properties": {
              "parser_id": {"type": "null"},
              "tool_transport_mode": {"const": "unavailable"}
            }
          }
        },
        {
          "if": {"properties": {"parser_mode": {"const": "prompt_based"}}},
          "then": {
            "properties": {
              "parser_id": {"type": "string", "minLength": 1},
              "tool_transport_mode": {"const": "prompt_parsed"}
            }
          }
        },
        {
          "if": {"properties": {"tool_transport_mode": {"const": "prompt_parsed"}}},
          "then": {
            "properties": {"parser_mode": {"const": "prompt_based"}}
          }
        }
      ]
    }
  },
  "$defs": {
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "logical_id", "sha256"],
      "properties": {
        "record_type": {"type": "string"},
        "logical_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "runtimeRef": {
      "allOf": [
        {"$ref": "#/$defs/evidenceRef"},
        {"properties": {"record_type": {"const": "runtime_profile"}}}
      ]
    },
    "modelRef": {
      "allOf": [
        {"$ref": "#/$defs/evidenceRef"},
        {"properties": {"record_type": {"const": "model_identity"}}}
      ]
    }
  }
}
