{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-model-bench.invalid/schemas/config.schema.json",
  "title": "Local Model Bench configuration",
  "type": "object",
  "required": ["providers", "models"],
  "properties": {
    "schema_version": {"const": 1},
    "result_root": {"type": "string"},
    "suites": {"type": "array", "items": {"type": "string"}},
    "providers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["type", "base_url"],
        "properties": {
          "type": {"enum": ["ollama", "openai_compatible", "llama_cpp"]},
          "base_url": {"type": "string"},
          "keep_alive": {"type": ["string", "integer"]},
          "api_key_env": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "provider", "name"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "provider": {"type": "string"},
          "name": {"type": "string"},
          "options": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "run": {
      "type": "object",
      "properties": {
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "wall_clock_seconds": {"type": "number", "exclusiveMinimum": 0},
        "retries": {"type": "integer", "minimum": 0},
        "retry_delay_seconds": {"type": "number", "minimum": 0},
        "unload_after_model": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "evaluation": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
