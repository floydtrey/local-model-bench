  "candidate_response_policy": "NATURAL_LANGUAGE_NO_NEW_JSON_HANDOFF_REQUIREMENT",
  "tracks": {
    "controlled_role_qualification": {
      "purpose": "Independent capability of each role against separately reviewed cases and input sources.",
      "roles": [
        "planner",
        "governor",
        "worker",
        "tester",
        "reviewer"
      ],
      "transports": [
        "direct_ollama",
        "native_dsh"
      ],
      "worker_modes": [
        "isolated_task",
        "cumulative_project"
      ],
      "upstream_candidate_output_as_authority": false,
      "reference_substitution_on_failure": false
    },
    "native_pipeline_integration": {
      "purpose": "Actual DSH release-bound chain; upstream artifacts may influence downstream outcomes.",
      "roles": [
        "pipeline"
      ],
      "transports": [
        "native_dsh"
      ],
      "worker_modes": [],
      "upstream_candidate_output_as_authority": false,
      "reference_substitution_on_failure": false
    }
  },
  "worker_modes": {
