      "acceptance_policy": "INDEPENDENT_TASK_ASSESSMENT"
    },
    "cumulative_project": {
      "input_equivalence": "IDENTICAL_INITIAL_STARTER_REFERENCE_PLAN_AND_TASKS_ONLY",
      "predecessor_policy": "ACTUAL_SAME_MODEL_PRIOR_CODE_AND_FREE_PROSE_HANDOFF",
      "acceptance_policy": "CUMULATIVE_ASSESSMENT_AND_BLOCK_FAILED_SUCCESSORS"
    }
  },
