  "requirement_groups": [
    {
      "id": "R01",
      "name": "Package and validation",
      "task": "T01",
      "positive": "Exact event schema, identifiers, aware UTC timestamp normalization, finite confidence, bounded TTL and JSON depth/size; detached normalized copies and canonical identity.",
      "negative": "Reject unknown/missing fields, coercion, invalid offsets/date, NaN/recursive/oversized data, overflow, mutable aliases and payload-as-command execution."
    },
    {
      "id": "R02",
      "name": "Durable journal",
      "task": "T02",
      "positive": "Real SQLite, global event_id uniqueness; append True new, False identical canonical duplicate, conflicting duplicate raises without overwriting; immediate commit and detached get/count/closed lifecycle.",
      "negative": "Reject data replacement, reset-on-corrupt, dropped write on process exit, noncommitted append, path substitution, invalid input causing writes, and bool/number identity normalization mistakes."
    },
    {
      "id": "R03",
      "name": "Bounded history",
      "task": "T03",
      "positive": "Validate and filter before paging, ascending (UTC timestamp,event_id), exact source/entity/type and half-open since/until; bounded offsets/limits, include expired/future evidence.",
      "negative": "Reject invalid query arguments even when empty; no arrival-order paging, off-by-one time windows, query-time deletion, or mutable returned references."
    },
    {
      "id": "R04",
      "name": "Explicit current observations",
      "task": "T04",
      "positive": "Require as_of, choose largest (timestamp,event_id) eligible event per (source,entity,type), exclude winners expired at exact boundary, never resurrect older after latest expired; deterministic replay and clock.",
      "negative": "Reject future suppression, stale resurrection, arrival/confidence precedence, cross-source fusion, inferred absence/identity, sleeps or system-clock dependency."
    },
    {
      "id": "R05",
      "name": "Atomic bounded ingestion",
      "task": "T05",
      "positive": "0–1000 event list, ordered bool results; database transaction rolls back entire batch if later invalid/conflicting input; prior commits and connection remain intact.",
      "negative": "Reject partial batches, broken transactions after rollback, inconsistent duplicate flags, silent conflicts or changed state after rejection."
    },
    {
      "id": "R06",
      "name": "Local CLI, tests and delivery",
      "task": "T06",
      "positive": "Real python -m entrypoint with append/ingest/get/count/history/state, one JSON response on stdout/empty stderr on success; UTF-8 JSONL atomic ingest; README and meaningful candidate tests.",
      "negative": "Reject leaking raw payloads/secrets/tracebacks, non-JSON errors, wrong exit 2, non-atomic invalid JSONL, network/deployment, hidden benchmark imports or false test claims."
    }
  ],
